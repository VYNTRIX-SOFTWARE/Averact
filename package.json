{
  "name": "@averact/core",
  "version": "0.1.0-alpha.0",
  "description": "Experimental action contracts for agent-initiated operations",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/runtime.test.mjs test/receipts.test.mjs",
    "example": "npm run build && node examples/purchase-order.mjs",
    "test:integration": "npm run build && node --test test/postgres.integration.test.mjs",
    "example:postgres": "npm run build && node examples/transaction-safety/demo.mjs"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
